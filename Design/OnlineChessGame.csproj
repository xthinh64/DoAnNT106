<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="LoginForm.cs" SubType="Form" />
    <Compile Update="RegisterForm.cs" SubType="Form" />
    <Compile Update="DashboardForm.cs" SubType="Form" />
    <Compile Update="ChessBoardForm.cs" SubType="Form" />
    <Compile Update="CaroBoardForm.cs" SubType="Form" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Network/OnlineChessGame.Network.csproj" />
    <ProjectReference Include="../Chess/OnlineChessGame.Chess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../Engines/Stockfish/**" Condition="Exists('../Engines/Stockfish')">
      <Link>Engines/Stockfish/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
