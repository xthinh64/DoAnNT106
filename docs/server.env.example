# Copy this file to .env alongside the Linux server executable.
CHESS_BIND_ADDRESS=0.0.0.0
CHESS_WORKER_MAX_ROOMS=32
CHESS_DB_CONNECTION="Server=127.0.0.1;Port=3306;Database=onlinechessdb;User ID=chess_auth;Password=REPLACE_ME;SslMode=None;"
CHESS_CERT_PATH=/opt/onlinechess/certs/auth.pfx
CHESS_CERT_PASSWORD=REPLACE_ME
AUTH_ALLOW_LEGACY_MIGRATION=false
